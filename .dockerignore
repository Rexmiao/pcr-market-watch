# Deny by default; permit only reviewed public source inputs.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!LICENSE
!.openai/
!.openai/hosting.json
!scripts/
!scripts/*.mjs
!scripts/*.py
!scripts/*.ps1
!worker/
!worker/*.js
!web/
!web/**
!data/
!data/seed.json
!data/cboe-seed.json
!data/market-brief.json
!drizzle/
!drizzle/*.sql
!drizzle/meta/
!drizzle/meta/*.json

# Exclusions remain last, including underneath otherwise allowed directories.
**/.git/**
**/node_modules/**
**/local-data/**
**/.preview-profile*/**
**/*.sqlite*
**/*.db
**/*.db-*
**/*.dpapi
**/*.log
**/.env*
**/*.pem
**/*.key
**/config.json
worker/assets.generated.js
